        RECT -0.530 0.810 2.180 2.715 ;
      LAYER pwell ;
        RECT -0.470 -0.380 2.205 0.485 ;
        RECT 0.515 -0.385 1.185 -0.380 ;
      LAYER li1 ;
        RECT 0.090 0.990 0.415 2.260 ;
        RECT 0.140 0.800 0.415 0.990 ;
        RECT 0.140 0.530 1.075 0.800 ;
        RECT 0.140 0.470 0.440 0.530 ;
        RECT 0.090 0.065 0.440 0.470 ;
        RECT 0.610 0.460 1.075 0.530 ;
  END
END buf
END LIBRARY


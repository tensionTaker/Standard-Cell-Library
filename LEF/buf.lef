VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO buf
  CLASS BLOCK ;
  FOREIGN buf ;
  ORIGIN 1.060 0.385 ;
  SIZE 3.365 BY 3.100 ;
  PIN A
    ANTENNAGATEAREA 0.253500 ;
    PORT
      LAYER li1 ;
        RECT -1.045 0.460 -0.580 0.800 ;
    END
  END A
  PIN VDD
    ANTENNADIFFAREA 0.762000 ;
    PORT
      LAYER li1 ;
        RECT -0.535 2.430 2.235 2.605 ;
        RECT -0.415 0.990 -0.085 2.430 ;
        RECT 1.185 0.990 1.515 2.430 ;
      LAYER met1 ;
        RECT -0.610 2.300 2.305 2.635 ;
    END
  END VDD
  PIN VGND
    USE GROUND ;
    PORT
      LAYER li1 ;
        RECT -0.410 -0.105 -0.080 0.420 ;
        RECT 1.245 -0.105 1.520 0.360 ;
        RECT -0.410 -0.285 2.200 -0.105 ;
      LAYER met1 ;
        RECT -0.460 -0.305 2.270 0.085 ;
    END
  END VGND
  PIN Y
    ANTENNADIFFAREA 0.507000 ;
